# ==========================================
# TRUSTVAULT ENVIRONMENT CONFIGURATION
# ==========================================

# Environment mode ('development', 'production', 'test')
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection String (must be isolated and authenticated in production)
MONGO_URI=mongodb://localhost:27017/trustvault

# JSON Web Token Secret
# CRITICAL: In production, generate a cryptographically strong 64-character secret
# Example: openssl rand -base64 48
JWT_SECRET=replace_with_a_super_strong_cryptographic_jwt_secret_key_minimum_64_characters

# JWT Expiration Period (e.g., '15m', '2h', '8h')
JWT_EXPIRES_IN=2h

# Storage Directory for Confidential Documents
# Defaults to backend/storage if left blank
STORAGE_DIR=./backend/storage

# Allowed CORS Origins (comma-separated list for allowlisted frontends)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://trustvault-app-five.vercel.app

# Initial System Administrator Provisioning Credentials (Used by scripts/seedAdmin.js)
ADMIN_NAME=TrustVault Administrator
ADMIN_EMAIL=admin@trustvault.com
ADMIN_PASSWORD=TrustVault@Admin2026!

